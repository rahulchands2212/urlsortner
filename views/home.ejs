<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>home page</title>
   <style>
:root {
  --primary: #8b5cf6;
  --primary-hover: #7c3aed;
  --text: #f1f5f9;
  --muted: #94a3b8;
  --border: rgba(148, 163, 184, 0.18);
  --background: #080b16;
  --white: #111827;
  --success: #34d399;
  --glow: rgba(139, 92, 246, 0.25);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  padding: 40px 20px;
  font-family: Arial, Helvetica, sans-serif;
  background:
    radial-gradient(ellipse at 15% 10%, #24154a 0%, transparent 40%),
    radial-gradient(ellipse at 90% 75%, #102d4a 0%, transparent 38%),
    var(--background);
  background-attachment: fixed;
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
}

/* Main layout */

.container {
  max-width: 1100px;
  margin: auto;
  perspective: 1200px;
}

h1 {
  text-align: center;
  font-size: clamp(34px, 5vw, 48px);
  margin-bottom: 10px;
  letter-spacing: -1.5px;
  background: linear-gradient(100deg, #c4b5fd, #818cf8, #67e8f9);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: titleGlow 4s ease-in-out infinite alternate;
}

.subtitle {
  text-align: center;
  color: var(--muted);
  margin-bottom: 35px;
  line-height: 1.7;
}

/* Glass cards */

.url-box,
.history {
  background: rgba(17, 24, 39, 0.78);
  border: 1px solid var(--border);
  border-radius: 20px;
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow:
    0 20px 60px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.045);
  transition:
    transform 0.35s ease,
    border-color 0.35s ease,
    box-shadow 0.35s ease;
  animation: fadeUp 0.7s ease both;
}

.url-box {
  padding: 30px;
  margin-bottom: 30px;
}

.url-box:hover,
.history:hover {
  transform: translateY(-5px) rotateX(1deg);
  border-color: rgba(139, 92, 246, 0.5);
  box-shadow:
    0 28px 65px rgba(0, 0, 0, 0.4),
    0 0 28px rgba(139, 92, 246, 0.1);
}

form {
  display: flex;
  gap: 12px;
  justify-content: center;
  align-items: center;
}

label {
  font-size: 16px;
  font-weight: 600;
  color: #e2e8f0;
}

input {
  width: 500px;
  max-width: 100%;
  height: 48px;
  padding: 0 15px;
  color: #f8fafc;
  background: rgba(3, 7, 18, 0.75);
  border: 1px solid #334155;
  border-radius: 10px;
  font-size: 15px;
  outline: none;
  transition: all 0.3s ease;
}

input::placeholder {
  color: #64748b;
}

input:focus {
  border-color: var(--primary);
  box-shadow:
    0 0 0 3px rgba(139, 92, 246, 0.15),
    0 0 22px rgba(139, 92, 246, 0.12);
  transform: translateY(-2px);
}

/* 3D gradient button */

button {
  position: relative;
  height: 48px;
  padding: 0 24px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 10px;
  background: linear-gradient(135deg, #8b5cf6, #4f46e5);
  color: white;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
  box-shadow:
    0 5px 0 #3730a3,
    0 10px 24px rgba(99, 102, 241, 0.22);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    filter 0.2s ease;
}

button:hover {
  background: linear-gradient(135deg, #a78bfa, #6366f1);
  transform: translateY(-3px);
  box-shadow:
    0 8px 0 #3730a3,
    0 15px 32px rgba(99, 102, 241, 0.35);
  filter: brightness(1.08);
}

button:active {
  transform: translateY(4px);
  box-shadow:
    0 1px 0 #3730a3,
    0 4px 12px rgba(99, 102, 241, 0.2);
}

/* Generated URL */

.generated {
  background: linear-gradient(
    135deg,
    rgba(6, 78, 59, 0.35),
    rgba(17, 24, 39, 0.85)
  );
  border: 1px solid rgba(52, 211, 153, 0.35);
  padding: 22px;
  border-radius: 15px;
  margin-bottom: 30px;
  box-shadow: 0 10px 35px rgba(16, 185, 129, 0.07);
  animation: fadeUp 0.6s ease both;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  overflow-wrap: anywhere;
}

.generated:hover {
  transform: translateY(-4px);
  box-shadow: 0 15px 40px rgba(16, 185, 129, 0.13);
}

.generated h3 {
  margin-top: 0;
  color: #a7f3d0;
}

.generated p {
  color: var(--success);
  font-size: 16px;
  font-weight: 600;
  overflow-wrap: anywhere;
  line-height: 1.7;
}

/* History table */

.history {
  padding: 25px;
  overflow-x: auto;
}

.history h2 {
  margin-top: 0;
  margin-bottom: 20px;
  color: #e9d5ff;
}

table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  min-width: 750px;
}

th {
  background: rgba(139, 92, 246, 0.13);
  color: #c4b5fd;
  font-size: 14px;
  text-align: left;
  padding: 15px 13px;
  border-bottom: 1px solid rgba(139, 92, 246, 0.3);
}

th:first-child {
  border-radius: 9px 0 0 0;
}

th:last-child {
  border-radius: 0 9px 0 0;
}

td {
  padding: 15px 13px;
  border-bottom: 1px solid var(--border);
  font-size: 14px;
  color: #cbd5e1;
  overflow-wrap: anywhere;
  transition: background 0.25s ease;
}

tbody tr {
  transition: transform 0.25s ease;
}

tbody tr:hover {
  transform: scale(1.005);
}

tbody tr:hover td {
  background: rgba(139, 92, 246, 0.075);
}

td a {
  color: #a78bfa;
  text-decoration: none;
  transition: color 0.2s ease;
}

td a:hover {
  color: #67e8f9;
  text-decoration: underline;
}

/* Animations */

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24px) rotateX(-3deg);
  }

  to {
    opacity: 1;
    transform: translateY(0) rotateX(0);
  }
}

@keyframes titleGlow {
  from {
    filter: drop-shadow(0 0 5px rgba(139, 92, 246, 0.1));
  }

  to {
    filter: drop-shadow(0 0 18px rgba(103, 232, 249, 0.22));
  }
}

/* Staggered entrance */

.url-box {
  animation-delay: 0.1s;
}

.generated {
  animation-delay: 0.2s;
}

.history {
  animation-delay: 0.3s;
}

/* Mobile responsive */

@media (max-width: 700px) {
  body {
    padding: 25px 12px;
  }

  h1 {
    font-size: 34px;
  }

  .subtitle {
    margin-bottom: 25px;
    font-size: 14px;
  }

  .url-box {
    padding: 20px;
    border-radius: 15px;
  }

  form {
    flex-direction: column;
    align-items: stretch;
  }

  label {
    text-align: left;
  }

  input,
  button {
    width: 100%;
  }

  .history {
    padding: 15px;
    border-radius: 15px;
  }

  .generated {
    padding: 17px;
  }

  /* Avoid excessive movement on touch screens */
  .url-box:hover,
  .history:hover {
    transform: none;
  }

  tbody tr:hover {
    transform: none;
  }
}

/* Accessibility */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
</style>
  </head>

  <body>

  <div class="container">

    <h1>URL Shortener</h1>

    <p class="subtitle">
      Convert your long URLs into short and easy-to-share links
    </p>

    <div class="url-box">
      <form method="post" action="/url">

        <label>Enter Original URL</label>

        <input
          type="text"
          name="url"
          placeholder="https://example.com"
          required
        />

        <button type="submit">Generate</button>

      </form>
    </div>


    <% if (locals.id) { %>

      <div class="generated">

        <h3>Generated URL</h3>

        <p>
          http://localhost:7000/url/<%= id %>
        </p>

      </div>

    <% } %>


    <div class="history">

      <h2>URL History</h2>

      <% if (locals.urls) { %>

        <table>

          <thead>
            <tr>
              <th>S No</th>
              <th>Original URL</th>
              <th>Short URL</th>
              <th>Click Count</th>
              <th>Created</th>
            </tr>
          </thead>

          <tbody>

            <% urls.forEach((url, index) => { %>

              <tr>

                <td><%= index + 1 %></td>

                <td><%= url.longurl %></td>

                <td>
                  <a href="/url/<%= url.shortid %>">
                    http://localhost:7000/url/<%= url.shortid %>
                  </a>
                </td>

                <td><%= url.clickcount %></td>

                <td>
                  <%= new Date(url.createdat).toLocaleString("en-IN", {
                    day: "2-digit",
                    month: "short",
                    year: "numeric",
                    hour: "2-digit",
                    minute: "2-digit"
                  }) %>
                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      <% } %>

    </div>

  </div>

</body>
</html>
