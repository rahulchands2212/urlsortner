<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>

    <style>
      * {
        box-sizing: border-box;
      }

      :root {
        --primary: #8b5cf6;
        --primary-hover: #7c3aed;
        --text: #f1f5f9;
        --muted: #94a3b8;
        --border: rgba(148, 163, 184, 0.2);
        --background: #080b16;
      }

      body {
        margin: 0;
        padding: 20px;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: Arial, Helvetica, sans-serif;
        background:
          radial-gradient(ellipse at 15% 15%, #28164d 0%, transparent 45%),
          radial-gradient(ellipse at 85% 85%, #102d4a 0%, transparent 40%),
          var(--background);
        color: var(--text);
        overflow-x: hidden;
      }

      /* Login Card */

      .login-box {
        width: 400px;
        max-width: 100%;
        background: rgba(17, 24, 39, 0.8);
        padding: 35px;
        border: 1px solid var(--border);
        border-radius: 20px;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow:
          0 25px 60px rgba(0, 0, 0, 0.4),
          inset 0 1px 0 rgba(255, 255, 255, 0.05);
        animation: cardEntrance 0.7s ease both;
        transition:
          transform 0.35s ease,
          box-shadow 0.35s ease,
          border-color 0.35s ease;
        perspective: 1000px;
      }

      .login-box:hover {
        transform: translateY(-5px) rotateX(1deg);
        border-color: rgba(139, 92, 246, 0.5);
        box-shadow:
          0 30px 70px rgba(0, 0, 0, 0.45),
          0 0 30px rgba(139, 92, 246, 0.1);
      }

      /* Heading */

      h1 {
        text-align: center;
        margin: 0 0 10px;
        font-size: 32px;
        letter-spacing: -0.8px;
        background: linear-gradient(100deg, #c4b5fd, #818cf8, #67e8f9);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: headingGlow 3s ease-in-out infinite alternate;
      }

      .subtitle {
        text-align: center;
        color: var(--muted);
        margin-bottom: 30px;
        line-height: 1.6;
        font-size: 14px;
      }

      /* Form */

      .form-group {
        margin-bottom: 20px;
      }

      label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        font-size: 14px;
        color: #e2e8f0;
      }

      input {
        width: 100%;
        height: 46px;
        padding: 0 14px;
        background: rgba(3, 7, 18, 0.75);
        color: #f8fafc;
        border: 1px solid #334155;
        border-radius: 9px;
        font-size: 15px;
        outline: none;
        transition:
          border-color 0.3s ease,
          box-shadow 0.3s ease,
          transform 0.3s ease;
      }

      input::placeholder {
        color: #64748b;
      }

      input:focus {
        border-color: var(--primary);
        box-shadow:
          0 0 0 3px rgba(139, 92, 246, 0.15),
          0 0 20px rgba(139, 92, 246, 0.1);
        transform: translateY(-2px);
      }

      /* 3D Button */

      button {
        width: 100%;
        height: 46px;
        margin-top: 5px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 9px;
        background: linear-gradient(135deg, #8b5cf6, #4f46e5);
        color: white;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        box-shadow:
          0 5px 0 #3730a3,
          0 10px 25px rgba(99, 102, 241, 0.2);
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          filter 0.2s ease;
      }

      button:hover {
        background: linear-gradient(135deg, #a78bfa, #6366f1);
        transform: translateY(-3px);
        box-shadow:
          0 8px 0 #3730a3,
          0 15px 30px rgba(99, 102, 241, 0.3);
        filter: brightness(1.08);
      }

      button:active {
        transform: translateY(4px);
        box-shadow: 0 1px 0 #3730a3;
      }

      /* Signup Link */

      .signup {
        text-align: center;
        margin-top: 25px;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.7;
      }

      .signup a {
        color: #a78bfa;
        text-decoration: none;
        font-weight: 700;
        transition: color 0.2s ease;
      }

      .signup a:hover {
        color: #67e8f9;
        text-decoration: underline;
      }

      /* Animations */

      @keyframes cardEntrance {
        from {
          opacity: 0;
          transform: translateY(25px) rotateX(-5deg) scale(0.97);
        }

        to {
          opacity: 1;
          transform: translateY(0) rotateX(0) scale(1);
        }
      }

      @keyframes headingGlow {
        from {
          filter: drop-shadow(0 0 4px rgba(139, 92, 246, 0.1));
        }

        to {
          filter: drop-shadow(0 0 15px rgba(103, 232, 249, 0.2));
        }
      }

      /* Mobile */

      @media (max-width: 480px) {
        body {
          padding: 16px;
        }

        .login-box {
          padding: 26px 22px;
          border-radius: 16px;
        }

        h1 {
          font-size: 29px;
        }

        .login-box:hover {
          transform: none;
        }
      }

      /* Accessibility */

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>

  <body>
    <div class="login-box">
      <h1>Login</h1>

      <p class="subtitle">Login to your account</p>

      <form action="/user/login" method="post">
        <div class="form-group">
          <label>Email</label>
          <input
            type="email"
            required
            name="email"
            placeholder="Enter your email"
          />
        </div>

        <div class="form-group">
          <label>Password</label>
          <input
            type="password"
            required
            name="password"
            placeholder="Enter your password"
          />
        </div>

        <button type="submit">Log in</button>
      </form>

      <div class="signup">
        Don't have an account?
        <a href="/signup">Sign Up</a>
      </div>
    </div>
  </body>
</html>
